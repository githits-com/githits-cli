{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "answer", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failure", "inconclusive"]
    },
    "answer": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  }
}
