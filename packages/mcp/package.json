{
  "name": "@githits/mcp",
  "version": "0.11.2",
  "description": "Reusable MCP server APIs and tools for GitHits",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./smoke-test": {
      "import": {
        "types": "./dist/smoke-test.d.ts",
        "default": "./dist/smoke-test.js"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup"
  },
  "keywords": [
    "githits",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "code-search"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githits-com/githits-cli.git"
  },
  "bugs": {
    "url": "https://github.com/githits-com/githits-cli/issues"
  },
  "homepage": "https://githits.com",
  "engines": {
    "node": "^20.18.1 || >=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
